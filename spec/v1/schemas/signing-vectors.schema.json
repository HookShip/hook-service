{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hookship:spec:v1:schema:signing-vectors",
  "title": "HookShip v1 HMAC signing vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "vectors",
    "signatureEncodingCases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "algorithm": {
      "const": "hmac-sha256"
    },
    "vectors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "secretHex",
          "request",
          "expectedCanonical",
          "expectedSignature"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "secretHex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "path",
              "credentialId",
              "timestamp",
              "nonce",
              "idempotencyKey",
              "eventId",
              "eventType",
              "route",
              "contentType",
              "bodyBase64",
              "bodySha256"
            ],
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "POST",
                  "GET"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/v1/event-ingests(?:/ing_[A-Z0-9]{26})?$"
              },
              "credentialId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "nonce": {
                "type": "string",
                "minLength": 16,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "idempotencyKey": {
                "type": "string",
                "maxLength": 128
              },
              "eventId": {
                "type": "string",
                "maxLength": 128
              },
              "eventType": {
                "type": "string",
                "maxLength": 128
              },
              "route": {
                "type": "string",
                "maxLength": 128
              },
              "contentType": {
                "type": "string",
                "maxLength": 255
              },
              "bodyBase64": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              "bodySha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "expectedCanonical": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expectedSignature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          }
        }
      }
    },
    "signatureEncodingCases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "valid"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
