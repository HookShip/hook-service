{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hookship:spec:v1:schema:configuration-bundle",
  "title": "HookShip v1 self-contained immutable signed configuration bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "bundleId",
    "generation",
    "contentChecksum",
    "content",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "configuration_bundle"
    },
    "schemaVersion": {
      "const": "1"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^cfg_[A-Z0-9]{26}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "contentChecksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "endpoints",
        "subscriptions",
        "retryPolicies",
        "throttlePolicies",
        "payloadPolicies",
        "sealedSecrets",
        "protocolVersions"
      ],
      "properties": {
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignmentId",
            "adapterId",
            "tenantRef",
            "environmentRef",
            "producerIds"
          ],
          "properties": {
            "assignmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "adapterId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "tenantRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "environmentRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "producerIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endpointId",
              "url",
              "signingSecretId"
            ],
            "properties": {
              "endpointId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "format": "uri"
              },
              "signingSecretId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "subscriptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subscriptionId",
              "route",
              "eventTypes",
              "endpointId",
              "retryPolicyId",
              "throttlePolicyId",
              "payloadPolicyId"
            ],
            "properties": {
              "subscriptionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "eventTypes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                }
              },
              "endpointId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "retryPolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "throttlePolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "payloadPolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "retryPolicies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "retryPolicyId",
              "maxAttempts",
              "initialDelaySeconds",
              "maxDelaySeconds",
              "backoff"
            ],
            "properties": {
              "retryPolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "initialDelaySeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "maxDelaySeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "backoff": {
                "const": "exponential"
              }
            }
          }
        },
        "throttlePolicies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "throttlePolicyId",
              "maxInFlight",
              "requestsPerSecond"
            ],
            "properties": {
              "throttlePolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "maxInFlight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "requestsPerSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "payloadPolicies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "payloadPolicyId",
              "maxBodyBytes",
              "retentionSeconds"
            ],
            "properties": {
              "payloadPolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "maxBodyBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "retentionSeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "sealedSecrets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secretId",
              "algorithm",
              "keyId",
              "keyVersion",
              "ciphertextBase64",
              "ciphertextSha256"
            ],
            "properties": {
              "secretId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "algorithm": {
                "const": "sealed-envelope-v1"
              },
              "keyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "keyVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "ciphertextBase64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 1048576,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              "ciphertextSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "protocolVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventIngest",
            "adapterCommand",
            "canonicalMetadata",
            "metadataIngest"
          ],
          "properties": {
            "eventIngest": {
              "const": "1"
            },
            "adapterCommand": {
              "const": "2026-07-01"
            },
            "canonicalMetadata": {
              "const": "2026-07-01"
            },
            "metadataIngest": {
              "const": "2026-07-01"
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signedAt",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "signedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        }
      }
    }
  }
}
