{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hookship:spec:v1:schema:fleet-registration",
  "title": "HookShip v1 fleet registration and configuration application report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "fleetMemberId",
    "assignmentId",
    "registrationNonce",
    "authenticatedIdentity",
    "supportedVersions",
    "candidate",
    "application",
    "observedAt"
  ],
  "properties": {
    "kind": {
      "const": "fleet_registration"
    },
    "schemaVersion": {
      "const": "1"
    },
    "fleetMemberId": {
      "type": "string",
      "pattern": "^flt_[A-Z0-9]{26}$"
    },
    "assignmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "registrationNonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "authenticatedIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "certificateSha256",
            "subject"
          ],
          "properties": {
            "kind": {
              "const": "mtls"
            },
            "certificateSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "issuer",
            "subject",
            "audience"
          ],
          "properties": {
            "kind": {
              "const": "workload_identity"
            },
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "format": "uri"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "audience": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      ]
    },
    "supportedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationBundle",
        "eventIngest",
        "adapterCommand",
        "canonicalMetadata",
        "metadataIngest"
      ],
      "properties": {
        "configurationBundle": {
          "$ref": "#/$defs/versionSet"
        },
        "eventIngest": {
          "$ref": "#/$defs/versionSet"
        },
        "adapterCommand": {
          "$ref": "#/$defs/versionSet"
        },
        "canonicalMetadata": {
          "$ref": "#/$defs/versionSet"
        },
        "metadataIngest": {
          "$ref": "#/$defs/versionSet"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "bundleSchemaVersion",
        "generation",
        "contentChecksum",
        "compatibilityAcknowledgedAt"
      ],
      "properties": {
        "bundleId": {
          "type": "string",
          "pattern": "^cfg_[A-Z0-9]{26}$"
        },
        "bundleSchemaVersion": {
          "const": "1"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentChecksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compatibilityAcknowledgedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "application": {
      "oneOf": [
        {
          "$ref": "#/$defs/acceptedApplication"
        },
        {
          "$ref": "#/$defs/appliedApplication"
        },
        {
          "$ref": "#/$defs/rejectedApplication"
        }
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "versionSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "lastKnownGood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "generation",
        "contentChecksum",
        "materializationChecksum",
        "appliedAt"
      ],
      "properties": {
        "bundleId": {
          "type": "string",
          "pattern": "^cfg_[A-Z0-9]{26}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentChecksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "materializationChecksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "acceptedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "acceptedAt"
      ],
      "properties": {
        "state": {
          "const": "accepted"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "lastKnownGood": {
          "$ref": "#/$defs/lastKnownGood"
        }
      }
    },
    "appliedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "appliedAt",
        "lastKnownGood"
      ],
      "properties": {
        "state": {
          "const": "applied"
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "lastKnownGood": {
          "$ref": "#/$defs/lastKnownGood"
        }
      }
    },
    "rejectedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rejectedAt",
        "rejectionCode"
      ],
      "properties": {
        "state": {
          "const": "rejected"
        },
        "rejectedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "rejectionCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "lastKnownGood": {
          "$ref": "#/$defs/lastKnownGood"
        }
      }
    }
  }
}
