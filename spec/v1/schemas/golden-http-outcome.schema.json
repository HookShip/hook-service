{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hookship:spec:v1:schema:golden-http-outcome",
  "title": "HookShip v1 golden HTTP outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "case",
    "request",
    "expected"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "case": {
      "type": "string",
      "enum": [
        "accepted",
        "duplicate",
        "conflict",
        "rejected"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "headers",
        "bodyBase64"
      ],
      "properties": {
        "method": {
          "const": "POST"
        },
        "path": {
          "const": "/v1/event-ingests"
        },
        "headers": {
          "type": "object",
          "minProperties": 9,
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "bodyBase64": {
          "type": "string",
          "maxLength": 1048576,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "headers",
        "body"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "enum": [
            200,
            202,
            409,
            422
          ]
        },
        "headers": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "body": {
          "oneOf": [
            {
              "$ref": "urn:hookship:spec:v1:schema:event-ingest-receipt"
            },
            {
              "$ref": "urn:hookship:spec:v1:schema:problem-details"
            }
          ]
        }
      }
    }
  }
}
