{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hookship:spec:v1:schema:timestamp-vectors",
  "title": "HookShip v1 exact signed timestamp cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "format": {
      "const": "YYYY-MM-DDTHH:MM:SSZ"
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "valid"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
