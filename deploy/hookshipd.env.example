# hookshipd environment file for a single Linux VM.
#
# Installed to /etc/hookship/hookshipd.env with mode 0600, owned by the non-root
# `hookship` service user. It is read by the systemd units as an EnvironmentFile.
# Never commit a filled-in copy of this file: it holds the payload key, database
# password, and any object-store/KMS credentials.
#
# Values marked REPLACE_ME are required and MUST be set before the service is
# started; deploy/scripts/install.sh refuses to start the service while any
# REPLACE_ME marker remains. See docs/configuration.md for the full reference.

# --- Backend selection (durable single-cell PostgreSQL) ---
HOOKSHIP_BACKEND=postgres
HOOKSHIP_CONFIG_FILE=/etc/hookship/assignments.yaml

# PostgreSQL 17+ connection URL. Use sslmode=require (or verify-full) when the
# database is not on this host's loopback. The password must never appear in
# process listings or logs, which is why it lives only in this 0600 file.
HOOKSHIP_DATABASE_URL=postgres://hookship:REPLACE_ME@127.0.0.1:5432/hookship?sslmode=disable

# 32-byte payload data-encryption key, hex or base64. Generate with:
#   openssl rand -hex 32
# Rotating this static key is only safe once historical payloads are terminal
# and reclaimed; see docs/runbooks/key-rotation.md. For seamless rotation use
# the AWS-compatible KMS provider below instead.
HOOKSHIP_PAYLOAD_KEY=REPLACE_ME

# --- Listener and transport security ---
# Default is loopback-only plaintext, which is safe without TLS or a proxy.
# To expose the service off-host, choose EXACTLY ONE:
#   1. Direct TLS: set both HOOKSHIP_TLS_CERT and HOOKSHIP_TLS_KEY, and bind a
#      non-loopback address. Probes then require https://.
#   2. Trusted proxy: set HOOKSHIP_PROXY_MODE=true when a reverse proxy or SSH
#      tunnel terminates TLS upstream, and keep the bind on loopback.
HOOKSHIP_LISTEN_ADDRESS=127.0.0.1:8080
# HOOKSHIP_PROXY_MODE=true
# HOOKSHIP_TLS_CERT=/etc/hookship/tls/tls.crt
# HOOKSHIP_TLS_KEY=/etc/hookship/tls/tls.key

HOOKSHIP_LOG_LEVEL=info

# --- Delivery SSRF opt-ins (default deny; enable only for trusted targets) ---
# HOOKSHIP_DELIVERY_ALLOW_LOOPBACK=false
# HOOKSHIP_DELIVERY_ALLOW_PRIVATE=false
# HOOKSHIP_DELIVERY_ALLOW_PLAINTEXT=false

# --- Worker, retry, retention (defaults shown; uncomment to override) ---
# HOOKSHIP_WORKER_CONCURRENCY=4
# HOOKSHIP_WORKER_LEASE=30s
# HOOKSHIP_DELIVERY_TIMEOUT=30s
# HOOKSHIP_MAX_ATTEMPTS=12
# HOOKSHIP_RETENTION_INTERVAL=1m
# HOOKSHIP_RETENTION_BATCH=500
# HOOKSHIP_OUTBOX_RETENTION=24h

# --- Optional: per-endpoint / per-assignment limits (0 = unlimited) ---
# HOOKSHIP_ENDPOINT_MAX_CONCURRENCY=0
# HOOKSHIP_ASSIGNMENT_MAX_CONCURRENCY=0
# HOOKSHIP_ENDPOINT_RATE_PER_SEC=0
# HOOKSHIP_ENDPOINT_RATE_BURST=0
# HOOKSHIP_ASSIGNMENT_RATE_PER_SEC=0
# HOOKSHIP_ASSIGNMENT_RATE_BURST=0

# --- Optional: metadata outbox sink ---
# HOOKSHIP_OUTBOX_SINK=log
# HOOKSHIP_METADATA_SINK_URL=
# HOOKSHIP_METADATA_SINK_TOKEN=REPLACE_ME

# --- Optional: S3-compatible object-store payload backend ---
# Requires TLS or HOOKSHIP_PAYLOAD_OBJECT_ALLOW_PLAINTEXT for a non-loopback,
# non-TLS endpoint. See docs/runbooks/minio-recovery.md.
# HOOKSHIP_PAYLOAD_BACKEND=object-store
# HOOKSHIP_PAYLOAD_OBJECT_ENDPOINT=127.0.0.1:9000
# HOOKSHIP_PAYLOAD_OBJECT_REGION=us-east-1
# HOOKSHIP_PAYLOAD_OBJECT_BUCKET=hookship-payloads
# HOOKSHIP_PAYLOAD_OBJECT_PATH_STYLE=true
# HOOKSHIP_PAYLOAD_OBJECT_USE_TLS=false
# HOOKSHIP_PAYLOAD_OBJECT_ALLOW_PLAINTEXT=false
# HOOKSHIP_PAYLOAD_OBJECT_ACCESS_KEY_ID=REPLACE_ME
# HOOKSHIP_PAYLOAD_OBJECT_SECRET_ACCESS_KEY=REPLACE_ME
# HOOKSHIP_PAYLOAD_OBJECT_CA_BUNDLE=/etc/hookship/tls/object-ca.pem

# --- Optional: AWS-compatible KMS payload key provider (seamless rotation) ---
# HOOKSHIP_KEY_PROVIDER=aws-kms
# HOOKSHIP_KMS_KEY_ID=REPLACE_ME
# HOOKSHIP_KMS_REGION=us-east-1
# HOOKSHIP_KMS_WRAPPED_DATA_KEY=REPLACE_ME
# HOOKSHIP_KMS_ACCESS_KEY_ID=REPLACE_ME
# HOOKSHIP_KMS_SECRET_ACCESS_KEY=REPLACE_ME
# HOOKSHIP_KMS_ENDPOINT=
